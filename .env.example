# Copy to .env. Used by docker compose (dev and prod). A variable exported in your shell with the
# same name wins over this file at `docker compose up` time (e.g. a stale OPENAI_API_KEY).
POSTGRES_PASSWORD=change-me
# dev stack only: 1 = no login, every request acts as the local `dev` writer account
DEV_AUTO_LOGIN=0
# openai | fake (fake = local hashing embedder, no API calls)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# prod only
IMAGE_TAG=latest
# Workflows page: Firecrawl API key (enable LinkedIn enrichment providers in the Firecrawl dashboard)
FIRECRAWL_API_KEY=
# pydantic-ai model for the agents, provider:model
AGENT_MODEL=openai:gpt-6-luna
# Logfire (US region): write token for the API; project URL only builds trace links in the UI
LOGFIRE_TOKEN=
LOGFIRE_PROJECT_URL=
